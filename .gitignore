__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments & Conda
.venv/
env/
venv/
ENV/
.conda/

# IDE & Editor specific files
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
